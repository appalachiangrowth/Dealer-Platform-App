{
  "expo": {
    "name": "Dealer Platform",
    "slug": "dealer-platform-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dealerapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dealershipplatform.dealerapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Take vehicle photos while walking the lot.",
        "NSPhotoLibraryUsageDescription": "Choose vehicle photos and your dealership logo.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.dealershipplatform.dealerapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take vehicle photos while walking the lot.",
          "photosPermission": "Choose vehicle photos and your dealership logo."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3d8f4a7a-5e82-4292-937a-e1b77a60a8f6"
      }
    }
  }
}
